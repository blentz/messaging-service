# Environment configuration for development
FLASK_APP=app
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-in-production
DATABASE_URL=postgresql://messaging_user:messaging_password@localhost:5432/messaging_service
WEBHOOK_SECRET=webhook-secret-change-in-production
TWILIO_WEBHOOK_SECRET=twilio-webhook-secret
SENDGRID_WEBHOOK_SECRET=sendgrid-webhook-secret
LOG_LEVEL=INFO